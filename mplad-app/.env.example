# ── Google OAuth ───────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── NextAuth ────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-32-char-random-secret
NEXTAUTH_URL=http://localhost:3000

# ── Authentication ─────────────────────────────────────────────────────────────
# JWT for API bearer tokens (officer API calls)
JWT_SECRET=replace-with-32-char-random-secret

# ── Email / OTP ────────────────────────────────────────────────────────────────
# Gmail SMTP (use an App Password, not your account password)
# https://support.google.com/accounts/answer/185833
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-app-password

# ── AI / Gemini ────────────────────────────────────────────────────────────────
# Optional — LUDO AI falls back to local intent engine if not set
GEMINI_API_KEY=your-gemini-api-key

# ── Database ────────────────────────────────────────────────────────────────────
# Default: file:../demo.db (SQLite). Change for PostgreSQL in production.
# DATABASE_URL=file:../demo.db

# ── Environment ─────────────────────────────────────────────────────────────────
NODE_ENV=production
